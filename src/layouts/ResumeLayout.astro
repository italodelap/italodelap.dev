---
import "@fontsource-variable/rubik/wght.css";
import "@fontsource-variable/rubik/wght-italic.css";
import "@fontsource/space-mono/400.css";
import "@fontsource/space-mono/700.css";
import "@fontsource/space-mono/400-italic.css";
import "@fontsource/space-mono/700-italic.css";

import "@/styles/global.css";

import BaseHead from "@/components/BaseHead.astro";
import LanguageSwitch from "@/components/LanguageSwitch.astro";
import PrintButton from "@/components/PrintButton.astro";

import { defaultLocale, localeRoutes } from "@/i18n/routes";
import { useTranslations, type Locale } from "@/i18n/ui";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

if (!Astro.site) {
  throw new Error(
    "Astro.site must be set in astro.config for the /resume ↔ /cv hreflang alternates",
  );
}

const alternates = [
  ...Object.values(localeRoutes).map((route) => ({
    hreflang: route.hreflang,
    href: new URL(route.href, Astro.site).href,
  })),
  {
    hreflang: "x-default",
    href: new URL(localeRoutes[defaultLocale].href, Astro.site).href,
  },
];
---

<!doctype html>
<html lang={localeRoutes[lang].hreflang}>
  <BaseHead
    title={t("page.title")}
    description={t("page.description")}
    alternates={alternates}
  />
  <script is:inline>
    document.documentElement.dataset.theme = "light";
    document.documentElement.style.colorScheme = "light";
  </script>
  <body class="bg-white text-neutral-900">
    <div
      class="static sm:fixed sm:top-4 sm:right-4 z-10 print:hidden flex justify-end items-center gap-2 p-4 sm:p-0"
    >
      <div class="bg-white rounded-md shadow-md">
        <LanguageSwitch lang={lang} />
      </div>
      <div class="bg-white rounded-md shadow-md">
        <PrintButton lang={lang} />
      </div>
    </div>
    <slot />
  </body>
</html>

<style>
  @media print {
    astro-dev-toolbar {
      display: none !important;
    }

    @page {
      margin: 1cm;
    }

    :global(.resume-entry) {
      break-inside: avoid;
    }
  }
</style>
