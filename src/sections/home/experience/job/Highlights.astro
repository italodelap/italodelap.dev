---
interface Props {
  id: string;
  highlights: string[];
}

const { id, highlights } = Astro.props;
---

<div
  id={id}
  class={`
    job__panel w-full rounded-2xl
    bg-zinc-50/85 dark:bg-zinc-900/85 backdrop-blur-md
    border border-white dark:border-white/10
  `}
>
  <ul class="p-3.5 flex flex-col gap-2 text-xs leading-relaxed text-neutral-800 dark:text-neutral-300">
    {
      highlights.map((highlight) => (
        <li class="flex gap-2">
          <span class="mt-1.5 size-1 shrink-0 rounded-full bg-current opacity-60" aria-hidden="true" />
          <span class="text-pretty">{highlight}</span>
        </li>
      ))
    }
  </ul>
</div>
