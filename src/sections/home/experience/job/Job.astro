---
import type { CollectionEntry } from "astro:content";

import ChevronUpIcon from "@/icons/ChevronUp.astro";

import Cover from "./Cover.astro";
import Data from "./Data.astro";
import Highlights from "./Highlights.astro";

type Props = Pick<CollectionEntry<"work-experience">, "id" | "data">;

const {
  id,
  data: { cover, from, highlights, position, shadow, title, to },
} = Astro.props;

const panelId = `job-highlights-${id}`;
---

<div class="job" data-open="false">
  <div class="absolute inset-0 -z-[1] overflow-hidden">
    <Cover cover={cover} />
  </div>
  <div class={`job__glow ${shadow}`}></div>
  <div
    class="absolute inset-0 flex flex-col items-center justify-end gap-3 px-4 py-4"
  >
    <Data from={from} position={position} title={title} to={to} />
    <button
      type="button"
      data-experience-disclosure
      aria-controls={panelId}
      aria-expanded="false"
      aria-label={`Show highlights of ${title}`}
      class="job__affordance size-7 shrink-0 grid place-content-center overflow-hidden rounded-full cursor-pointer text-neutral-500 dark:text-neutral-50 bg-zinc-50/50 bg-blend-luminosity backdrop-blur-lg dark:bg-zinc-900/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 dark:focus-visible:outline-blue-100"
    >
      <ChevronUpIcon class="size-3.5" />
    </button>
    <Highlights id={panelId} highlights={highlights ?? []} />
  </div>
</div>
