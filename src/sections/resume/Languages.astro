---
import ResumeSection from "@/components/ResumeSection.astro";

import { getResumeContent } from "@/i18n";
import { useTranslations, type Locale } from "@/i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { languages } = await getResumeContent(lang);
---

<ResumeSection
  title={t("section.languages")}
  titleClass="text-xs font-semibold text-indigo-700 uppercase tracking-wide border-b border-neutral-200 pb-1"
  class="grid gap-1"
>
  <ul class="flex flex-wrap gap-x-4 gap-y-1">
    {
      languages.map(({ language, level }) => (
        <li class="font-space-mono text-[11px]">
          {language} <span class="text-neutral-500">({level})</span>
        </li>
      ))
    }
  </ul>
</ResumeSection>
