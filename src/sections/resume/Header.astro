---
import OptimizedImage from "@/components/OptimizedImage.astro";
import ResumeSection from "@/components/ResumeSection.astro";

import { basics } from "@/config/site.json";
import { getResumeContent } from "@/i18n";
import type { Locale } from "@/i18n/ui";

import { getPrintFriendlyContactChannels } from "@/lib/contact-channels";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const content = await getResumeContent(lang);
---

<ResumeSection class="flex items-start gap-4">
  <OptimizedImage
    alt={basics.name}
    src={basics.profilePhoto}
    class="object-cover object-center border rounded-md aspect-square size-19 shrink-0 border-neutral-200"
  />
  <div>
    <h1 class="text-lg font-bold text-indigo-700">{basics.name}</h1>
    <p class="text-xs font-semibold text-neutral-700">{content.label}</p>
    <p class="font-space-mono text-[11px] text-neutral-500">
      {content.location.city}, {content.location.country}
    </p>
    <p class="text-[11px] text-indigo-700">
      {getPrintFriendlyContactChannels()}
    </p>
  </div>
</ResumeSection>
