---
import OptimizedImage from "@/components/OptimizedImage.astro";
import ResumeSection from "@/components/ResumeSection.astro";

import { basics } from "@/config/site.json";

import { getPrintFriendlyContactChannels } from "@/lib/contact-channels";
---

<ResumeSection class="flex items-start gap-4">
  <OptimizedImage
    alt={basics.name}
    src={basics.profilePhoto}
    class="aspect-square size-[5.625rem] shrink-0 rounded-md border border-neutral-200 object-cover object-center"
  />
  <div class="grid gap-0.5">
    <h1 class="text-2xl font-bold text-indigo-700">{basics.name}</h1>
    <p class="font-semibold text-sm text-neutral-700">{basics.label}</p>
    <p class="font-space-mono text-xs text-neutral-500">
      {basics.location.city}, {basics.location.country}
    </p>
    <p class="text-xs text-indigo-700">
      {getPrintFriendlyContactChannels()}
    </p>
  </div>
</ResumeSection>
