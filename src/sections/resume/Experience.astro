---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import ExperienceDuration from "@/components/ExperienceDuration.astro";
import ResumeSection from "@/components/ResumeSection.astro";

import { getSortedExperience } from "@/lib/sorting";

type Subitem = NonNullable<CollectionEntry<"work-experience">["data"]["subitems"]>[number];

function hasHighlights(entry: { highlights?: string[] }): boolean {
  return Boolean(entry.highlights && entry.highlights.length > 0);
}

const workExperience = await getCollection("work-experience");
const sortedWorkExperience = getSortedExperience(workExperience);

const curatedExperience = sortedWorkExperience
  .map((job) => {
    const curatedSubitems: Subitem[] = job.data.subitems
      ? getSortedExperience(job.data.subitems).filter(hasHighlights)
      : [];

    return { job, curatedSubitems };
  })
  .filter(({ job, curatedSubitems }) => hasHighlights(job.data) || curatedSubitems.length > 0);
---

<ResumeSection
  title="Experience"
  titleClass="text-xs font-semibold text-indigo-700 uppercase tracking-wide border-b border-neutral-200 pb-1"
  class="grid gap-2"
>
  <ul class="grid gap-2">
    {
      curatedExperience.map(({ job: { data: { company, from, highlights, position, to } }, curatedSubitems }) => (
        <li class="resume-entry">
          <article class="grid gap-0.5">
            <header class="flex flex-col sm:flex-row sm:justify-between sm:gap-4">
              <div>
                <h3 class="text-sm font-semibold leading-tight">{company}</h3>
                {curatedSubitems.length === 0 && (
                  <h4 class="text-xs italic">{position}</h4>
                )}
              </div>
              <div class="font-space-mono text-xs text-neutral-500">
                <ExperienceDuration from={from} to={to} />
              </div>
            </header>
            {curatedSubitems.length === 0 && highlights && (
              <ul class="mt-0.5 pl-5 list-disc grid gap-0.5">
                {highlights.map((highlight) => (
                  <li class="font-space-mono text-xs">{highlight}</li>
                ))}
              </ul>
            )}
            {curatedSubitems.length > 0 && (
              <ul class="mt-0.5 grid gap-1.5">
                {curatedSubitems.map(({ from: subFrom, highlights: subHighlights, position: subPosition, to: subTo }) => (
                  <li class="resume-entry grid gap-0.5">
                    <div class="flex flex-col sm:flex-row sm:justify-between sm:gap-4">
                      <h4 class="text-xs italic font-semibold">{subPosition}</h4>
                      <div class="font-space-mono text-xs text-neutral-500">
                        <ExperienceDuration from={subFrom} to={subTo} />
                      </div>
                    </div>
                    <ul class="mt-0.5 pl-5 list-disc grid gap-0.5">
                      {subHighlights!.map((highlight) => (
                        <li class="font-space-mono text-xs">{highlight}</li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ul>
            )}
          </article>
        </li>
      ))
    }
  </ul>
</ResumeSection>
