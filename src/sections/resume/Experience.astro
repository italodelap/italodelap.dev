---
import ExperienceDuration from "@/components/ExperienceDuration.astro";
import ResumeSection from "@/components/ResumeSection.astro";

import { getResumeContent } from "@/i18n";
import { useTranslations, type Locale } from "@/i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { experience } = await getResumeContent(lang);
---

<ResumeSection
  title={t("section.experience")}
  titleClass="text-xs font-semibold text-indigo-700 uppercase tracking-wide border-b border-neutral-200 pb-1"
  class="grid gap-2"
>
  <ul class="grid gap-2">
    {
      experience.map(({ company, from, to, position, highlights, subitems }) => (
        <li class="resume-entry">
          <article class="grid gap-0.5">
            <header class="flex flex-col sm:flex-row sm:justify-between sm:gap-4">
              <div>
                <h3 class="text-sm font-semibold leading-tight">{company}</h3>
                {subitems.length === 0 && (
                  <h4 class="text-xs italic">{position}</h4>
                )}
              </div>
              <div class="font-space-mono text-xs text-neutral-500">
                <ExperienceDuration from={from} to={to} lang={lang} />
              </div>
            </header>
            {subitems.length === 0 && highlights.length > 0 && (
              <ul class="mt-0.5 pl-5 list-disc grid gap-0.5">
                {highlights.map((highlight) => (
                  <li class="font-space-mono text-xs">{highlight}</li>
                ))}
              </ul>
            )}
            {subitems.length > 0 && (
              <ul class="mt-0.5 grid gap-1.5">
                {subitems.map((sub) => (
                  <li class="resume-entry grid gap-0.5">
                    <div class="flex flex-col sm:flex-row sm:justify-between sm:gap-4">
                      <h4 class="text-xs italic font-semibold">{sub.position}</h4>
                      <div class="font-space-mono text-xs text-neutral-500">
                        <ExperienceDuration from={sub.from} to={sub.to} lang={lang} />
                      </div>
                    </div>
                    <ul class="mt-0.5 pl-5 list-disc grid gap-0.5">
                      {sub.highlights.map((highlight) => (
                        <li class="font-space-mono text-xs">{highlight}</li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ul>
            )}
          </article>
        </li>
      ))
    }
  </ul>
</ResumeSection>
