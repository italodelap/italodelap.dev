---
import ExperienceDuration from "@/components/ExperienceDuration.astro";
import ResumeSection from "@/components/ResumeSection.astro";

import { getResumeContent } from "@/i18n";
import { useTranslations, type Locale } from "@/i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { education } = await getResumeContent(lang);
---

<ResumeSection
  title={t("section.education")}
  titleClass="text-xs font-semibold text-indigo-700 uppercase tracking-wide border-b border-neutral-200 pb-1"
  class="grid gap-3"
>
  <ul class="grid gap-4">
    {
      education.map(({ area, from, notes, institution, to }) => (
        <li class="resume-entry">
          <article>
            <div class="flex flex-col sm:flex-row sm:justify-between sm:gap-4">
              <div>
                <h3 class="text-xs font-semibold leading-tight">{area}</h3>
                <h4 class="text-xs italic">{institution}</h4>
              </div>
              <div class="text-[11px] font-space-mono text-neutral-500">
                <ExperienceDuration from={from} to={to} lang={lang} />
              </div>
            </div>
            <p class="font-space-mono text-[10px]">({notes})</p>
          </article>
        </li>
      ))
    }
  </ul>
</ResumeSection>
