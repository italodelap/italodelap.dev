---
import printerIcon from "@/assets/icons/printer.svg?raw";
---

<button
  type="button"
  id="print-button"
  aria-label="Print CV"
  title="Print CV"
  class={`
    inline-flex items-center justify-center rounded-md p-2
    text-neutral-600 border-2 border-neutral-200
    transition-colors duration-300
    hover:text-neutral-700 hover:border-neutral-300 hover:bg-neutral-200/50
  `}
>
  <Fragment set:html={printerIcon} />
</button>

<script>
  document
    .getElementById("print-button")
    ?.addEventListener("click", () => window.print());
</script>
