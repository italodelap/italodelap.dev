---
import printerIcon from "@/assets/icons/printer.svg?raw";
import { useTranslations, type Locale } from "@/i18n/ui";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const label = t("print.label");
---

<button
  type="button"
  id="print-button"
  aria-label={label}
  title={label}
  class={`
    inline-flex items-center justify-center rounded-md p-2
    text-neutral-600 border-2 border-neutral-500
    transition-colors duration-300
    hover:text-neutral-700 hover:border-neutral-600 hover:bg-neutral-200/50
  `}
>
  <Fragment set:html={printerIcon} />
</button>

<script>
  document
    .getElementById("print-button")
    ?.addEventListener("click", () => window.print());
</script>
