---
interface Props {
  class?: string;
  title?: string;
  titleClass?: string;
}

const {
  class: className = "",
  title,
  titleClass = "text-2xl font-bold",
} = Astro.props;
---

<section class={`${className} max-w-3xl mx-auto`}>
  {title && <h2 class={titleClass}>{title}</h2>}
  <slot />
</section>
