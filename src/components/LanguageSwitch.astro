---
import { localeRoutes } from "@/i18n/routes";
import type { Locale } from "@/i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

// Every locale except the current one. Two locales → one link; a third would
// render two here with no code change.
const targets = (Object.keys(localeRoutes) as Locale[]).filter(
  (locale) => locale !== lang,
);
---

{
  targets.map((target) => {
    const route = localeRoutes[target];
    return (
      <a
        href={route.href}
        hreflang={route.hreflang}
        lang={route.hreflang}
        class={`
          inline-flex items-center justify-center rounded-md px-3 py-2
          text-xs font-medium text-neutral-600 border-2 border-neutral-500
          transition-colors duration-300
          hover:text-neutral-700 hover:border-neutral-600 hover:bg-neutral-200/50
        `}
      >
        {route.switchLabel}
      </a>
    );
  })
}
